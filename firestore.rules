rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global safety net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Pillar 2: Validation Blueprints
    function isValidLoan(data) {
      let requiredFields = ['client', 'date', 'debt', 'remaining', 'principal', 'status'];
      let optionalFields = ['phone', 'idNumber', 'address', 'workplace', 'interestRate', 'fixedQuota', 'progress', 'createdAt', 'updatedAt', 'freqDays', 'installments', 'hasCustomLastInstallment', 'customLastInstallment'];
      return data.keys().hasAll(requiredFields)
        && data.keys().size() <= (requiredFields.size() + optionalFields.size())
        && data.client is string && data.client.size() <= 120
        && data.date is string
        && data.debt is number
        && data.remaining is number
        && data.principal is number
        && data.status in ['ACTIVO', 'PAGADO', 'RENOVADO', 'MORA']
        && (!data.has('hasCustomLastInstallment') || data.hasCustomLastInstallment is bool)
        && (!data.has('customLastInstallment') || data.customLastInstallment == null || data.customLastInstallment is number);
    }

    function isValidTransaction(data) {
      let requiredFields = ['type', 'amount', 'concept', 'date'];
      let optionalFields = ['loanId', 'clientName', 'updatedAt'];
      return data.keys().hasAll(requiredFields)
        && data.keys().size() <= (requiredFields.size() + optionalFields.size())
        && data.type in ['INYECCION', 'RETIRO']
        && data.amount is number
        && data.concept is string && data.concept.size() <= 1000
        && data.date is string;
    }

    function isValidClient(data) {
      let requiredFields = ['name'];
      let optionalFields = ['phone', 'idNumber', 'address', 'workplace', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredFields)
        && data.keys().size() <= (requiredFields.size() + optionalFields.size())
        && data.name is string && data.name.size() <= 120
        && (!data.has('phone') || data.phone is string)
        && (!data.has('idNumber') || data.idNumber is string)
        && (!data.has('address') || data.address is string)
        && (!data.has('workplace') || data.workplace is string);
    }

    // Match Rules
    match /artifacts/prestafacil-v1/users/{userId} {
      allow get: if isOwner(userId);
      
      match /loans/{loanId} {
        // Pillar 8: Secure List Queries
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        
        allow create: if isOwner(userId) 
          && isValidLoan(incoming()) 
          && isValidId(loanId);
        
        allow update: if isOwner(userId) 
          && isValidLoan(incoming())
          && (
            // Action: Edit Profile
            (incoming().diff(existing()).affectedKeys().hasOnly(['client', 'phone', 'idNumber', 'address', 'workplace', 'status', 'remaining', 'progress', 'interestRate', 'fixedQuota', 'updatedAt', 'freqDays', 'installments', 'hasCustomLastInstallment', 'customLastInstallment'])) ||
            // Action: Process Payment / Reversal
            (incoming().diff(existing()).affectedKeys().hasOnly(['remaining', 'progress', 'status', 'updatedAt'])) ||
            // Action: Renew
            (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'remaining', 'progress', 'updatedAt']))
          );
        
        allow delete: if isOwner(userId);
      }

      match /transactions/{transactionId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        
        allow create: if isOwner(userId) 
          && isValidTransaction(incoming()) 
          && isValidId(transactionId);
          
        allow update: if isOwner(userId) && isValidTransaction(incoming());
        allow delete: if isOwner(userId);
      }

      match /clients/{clientId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidClient(incoming());
        allow update: if isOwner(userId) && isValidClient(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
